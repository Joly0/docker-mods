#!/usr/bin/with-contenv bash

# Register the packages Remote Play needs with the base image's shared
# package install (init-mods-package-install runs after this script).
#   gamescope   Valve's compositor; Steam runs inside it so Remote Play
#               captures the composited screen, menus included
#   pipewire    carries gamescope's picture to Steam
#   wireplumber session manager for pipewire
#   32-bit pipewire client libs: Steam's client is 32-bit
#   mangoapp    Steam's performance overlay (FPS) in Big Picture, set in
#               the quick access menu as on a Steam Deck

# Only with REMOTEPLAY=true. Without it the mod does nothing and the
# container behaves exactly as the image ships it.
if [[ "${REMOTEPLAY,,}" != "true" ]]; then
    exit 0
fi

PACKAGES=(
    gamescope
    pipewire
    wireplumber
    mangoapp
    libpipewire-0.3-0t64:i386
    libpipewire-0.3-modules:i386
    libspa-0.2-modules:i386
)
missing=()
for p in "${PACKAGES[@]}"; do
    dpkg -s "$p" >/dev/null 2>&1 || missing+=("$p")
done
if [ ${#missing[@]} -gt 0 ]; then
    echo "**** [steam-remoteplay] adding to package install list: ${missing[*]} ****"
    printf '%s\n' "${missing[@]}" >> /mod-repo-packages-to-install.list
else
    echo "**** [steam-remoteplay] packages already installed ****"
fi
